# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mentorlab

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=90

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Whisper (OpenAI)
OPENAI_API_KEY=sk-xxx

# S3-compatible storage (for audio files)
S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
S3_BUCKET_NAME=mentorlab-audio
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx

# FCM (Phase 3)
# FCM_CREDENTIALS_PATH=./firebase-credentials.json

# CORS
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:5173"]
